{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blender run manifest",
  "description": "Written by scripts/run_manifest.py to <out_dir>/run_manifest.json: the brief plus one event per stage gate.",
  "type": "object",
  "required": ["schema", "created", "brief", "events"],
  "properties": {
    "schema": {"const": "run-manifest/1"},
    "created": {"type": "string"},
    "brief": {"type": ["object", "string"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "skill", "script", "args", "result_summary", "verdict", "reason", "capture", "time"],
        "properties": {
          "stage": {"enum": ["inspect", "brief", "model", "look_dev", "light_camera", "validate", "export", "verify"]},
          "skill": {"type": "string"},
          "script": {"type": "string"},
          "args": {"type": "object"},
          "result_summary": {"type": ["object", "string"]},
          "verdict": {"enum": ["PASS", "FAIL", "NOT_CHECKED", "N/A"]},
          "reason": {"type": ["string", "null"]},
          "warn": {"type": "boolean"},
          "capture": {"type": ["string", "null"]},
          "time": {"type": "string"},
          "cause": {"enum": ["geometry", "materials", "lighting", "camera", "export", "tool-error"]},
          "stopped": {"type": "boolean"},
          "exports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}
